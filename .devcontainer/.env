# Single source of truth for every pinned version this dev container builds
# from — base image digest, apt packages, the mise installer, every mise-managed
# tool, and the npm-global CLIs. See AGENTS.md, "Toolchain (mise)".
#
# NOT A SECRET. This file is deliberately committed (.gitignore negates the
# bare `.env` rule for it). It is only named `.env` because Docker Compose
# auto-loads a file with exactly that name from beside docker-compose.yml —
# which is what lets docker-compose.yml's `build.args: { NAME: ${NAME} }` reach
# the Dockerfile's `ARG NAME` with no --env-file flag and no custom tooling.
#
# TWO consumers read this one file:
#   1. Docker Compose  → Dockerfile build ARGs (base image, apt, npm globals)
#   2. mise            → tool versions, via `[env] _.file` + {{ env.X }}
#                        templating in mise.toml at the repo root.
#
# Format is dotenv: KEY=VALUE, no `export`, no quotes needed. Every key here is
# exported into the shell environment of the container by mise's `_.file`, so
# treat these names as occupying the global env namespace.
#
# TO BUMP ANYTHING: edit the value here, then run
#   mise lock -p linux-x64,linux-arm64,macos-arm64,macos-x64
# and commit .devcontainer/.env together with mise.lock. CI fails the PR if the
# lockfile is not in sync (a bumped version with a stale lock has no reviewed
# checksum to verify against; `pnpm verify:mise` is the gate).

# ---------------------------------------------------------------------------
# Base image
# ---------------------------------------------------------------------------
# Digest-pinned: tags are mutable, digests are not. Re-resolve when bumping:
#   curl -sI -H "Accept: application/vnd.oci.image.index.v1+json" \
#     https://mcr.microsoft.com/v2/devcontainers/base/manifests/ubuntu24.04 \
#     | grep -i docker-content-digest
BASE_IMAGE_TAG=ubuntu24.04
BASE_IMAGE_DIGEST=sha256:cfd5dd36c0d0d88de015aad5aa4f4b94e76d9f658a1e3055b27fd7d0fd1d84a6

# ---------------------------------------------------------------------------
# apt packages
# ---------------------------------------------------------------------------
# Pinned exact against the archive for the digest above (read from `apt-cache
# policy` in that exact image, not copied guesses). Bump together with
# BASE_IMAGE_DIGEST: when a superseded security patch drops out of the archive
# the pinned install fails, and that failure IS the signal to refresh both.
#
# Deliberately short. devcontainers/base:ubuntu24.04 already ships git, zsh,
# gnupg2, openssh-client, ca-certificates, curl, wget, net-tools, iproute2,
# lsof and jq. Re-pinning what is already present would only add stale-pin
# build failures. These are what neither the base image nor mise provides:
#   build-essential  C toolchain for node-gyp native deps
#   zlib1g-dev       GraalVM `native-image` links against libz at build time
#   unzip / zip      archive handling for tooling and CI scripts
#   iputils-ping     ping (absent from the base image)
#   dnsutils         dig / nslookup, for debugging service resolution
#   netcat-openbsd   nc, for "is that port actually open" checks
#   traceroute       path/MTU debugging
APT_BUILD_ESSENTIAL_VERSION=12.10ubuntu1
APT_ZLIB1G_DEV_VERSION=1:1.3.dfsg-3.1ubuntu2.1
APT_UNZIP_VERSION=6.0-28ubuntu4.1
APT_ZIP_VERSION=3.0-13ubuntu0.2
APT_IPUTILS_PING_VERSION=3:20240117-1ubuntu0.1
APT_DNSUTILS_VERSION=1:9.18.39-0ubuntu0.24.04.5
APT_NETCAT_OPENBSD_VERSION=1.226-1ubuntu2
APT_TRACEROUTE_VERSION=1:2.1.5-1

# ---------------------------------------------------------------------------
# mise itself
# ---------------------------------------------------------------------------
# The installer is pinned too — an unpinned `curl https://mise.run | sh` is the
# one unverified binary in an otherwise fully-pinned image, and it is the tool
# that installs everything else.
MISE_VERSION=v2026.8.0

# ---------------------------------------------------------------------------
# Toolchain — consumed by mise.toml via {{ env.X }}
# ---------------------------------------------------------------------------
# Exact patches, never fuzzy majors: `mise lock --bump` once resolved a fuzzy
# "24" to 24.16.0 while 24.18.1 was current, silently leaving the container two
# patches behind.
NODE_VERSION=24.18.1
PYTHON_VERSION=3.14.6
# GraalVM CE (not Oracle): GPLv2+CPE is unambiguous for a template others fork.
# native-image ships inside the distribution as of 21 — no `gu install` step —
# and links against libz, hence APT_ZLIB1G_DEV_VERSION above. Also serves as
# SonarLint's language-server JRE, which requires a real JRE 21+ path.
JAVA_VERSION=graalvm-community-21.0.2
UV_VERSION=0.12.0
GH_VERSION=2.96.0
# MUST match the image tag in .github/workflows/security.yml — `pnpm verify:mise`
# fails if it does not, because a drifted pair breaks nothing loudly. The pre-commit
# hook and the CI job are the same scanner on the same default ruleset (there is
# no .gitleaks.toml — neither side overrides it), and they only stay the same
# scanner if this number and that tag move together.
GITLEAKS_VERSION=8.30.1
AWSCLI_VERSION=2.36.14
GORTEX_VERSION=0.61.4
OPENCODE_VERSION=1.18.10
RTK_VERSION=0.44.1

# ---------------------------------------------------------------------------
# npm-global CLIs — installed by the Dockerfile, NOT by mise
# ---------------------------------------------------------------------------
# mise's npm backend installs with --ignore-scripts / --omit=optional, so this
# package's postinstall never runs and its platform-native binary is never
# fetched; `claude` then fails at runtime with "native binary not installed".
# `npm install -g` runs the postinstall properly. Verified the hard way.
CLAUDE_CODE_VERSION=2.1.220

# ---------------------------------------------------------------------------
# devcontainer Features
# ---------------------------------------------------------------------------
# Authoritative pin lives in .devcontainer/devcontainer-lock.json (version +
# integrity digest); this copy exists so a human scanning "what is pinned
# where" sees it in one place. Keep the two in sync when bumping.
DOCKER_IN_DOCKER_FEATURE_VERSION=4.0.0
