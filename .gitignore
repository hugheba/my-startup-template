# deps
node_modules/
.pnpm-store/

# builds
.next/
out/
dist/
*.tsbuildinfo

# turbo
.turbo/

# coverage
coverage/

# env — see .env.example for which file stores what
.env
.env.local
.env.*.local
# amplify.yml writes real environment values here at build time, so it must
# never be committed. `.env.*.local` above does NOT cover it.
.env.production
!.env.example
# NOT a secret: the devcontainer pin manifest (base image digest, apt and tool
# versions). It is only named `.env` because Docker Compose auto-loads a file
# with exactly that name from beside docker-compose.yml — which is what feeds
# the Dockerfile's build ARGs. The bare `.env` rule above matches at ANY depth,
# so without this negation the manifest is silently untracked and every fresh
# clone builds a container with no toolchain.
!.devcontainer/.env

# editor
.DS_Store
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# vercel
.vercel/

# python
scripts/.venv/
scripts/__pycache__/
scripts/**/__pycache__/
scripts/.ruff_cache/
scripts/.pytest_cache/

# BMAD output (docs/bmad-output/) is intentionally NOT ignored —
# template users commit BMAD's PRD, architecture, stories, etc. as work product.

# playwright / test outputs
playwright-report/
test-results/

# local agent scratch state (session buffers, daily notes) — machine-local,
# never work product. Prettier 3 reads .gitignore as an ignore path, so listing
# it here also keeps `pnpm format:check` off it.
.remember/

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# Transient working document — cross-repo devcontainer analysis. Local only:
# it references other organisations' internal repos and standards and must not
# be published from this public template.
DEVCONTAINER.md
