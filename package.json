{
  "name": "my-startup-template",
  "version": "0.1.0",
  "private": true,
  "description": "Opinionated Turborepo template for BMAD-driven Next.js startups",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "preinstall": "node -e \"if(!(process.env.npm_config_user_agent||'').startsWith('pnpm/')){console.error('\\n  This repo uses pnpm, not npm or yarn.\\n  Run:  corepack enable && pnpm install\\n');process.exit(1)}\"",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "lint:md": "markdownlint-cli2",
    "lint:md:fix": "markdownlint-cli2 --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "bmad:init": "npx -y bmad-method@6.10.0 install --yes --tools claude-code --modules bmm,bmb,cis,tea --set core.output_folder=docs/bmad-output",
    "bmad:init:interactive": "npx -y bmad-method@6.10.0 install",
    "verify:vscode": "node scripts/verify-vscode-extensions.mjs",
    "verify:deps": "node scripts/verify-exact-deps.mjs",
    "verify:mise": "node scripts/verify-mise-lock.mjs",
    "rename:project": "node scripts/rename-template.mjs",
    "prepare": "lefthook install || echo '! lefthook install failed - git hooks are NOT active'"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@my-startup-template/eslint-config": "workspace:*",
    "@my-startup-template/prettier-config": "workspace:*",
    "@next/eslint-plugin-next": "16.3.0",
    "eslint": "9.39.5",
    "lefthook": "2.1.10",
    "markdownlint-cli2": "0.23.2",
    "prettier": "3.9.6",
    "prettier-plugin-organize-imports": "4.3.0",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "2.10.8",
    "typescript": "6.0.3"
  },
  "prettier": "@my-startup-template/prettier-config"
}
