{
  // Prettier already owns markdown whitespace/wrapping for everything it
  // formats, so the rules disabled below are either its job or actively wrong
  // for this repo's docs. Everything else stays on.
  "config": {
    "default": true,

    // MD013 line-length: prose here is written unwrapped and Prettier's
    // `proseWrap: preserve` keeps it that way. A column cap would fight it.
    "MD013": false,

    // MD033 inline HTML: README/AGENTS use <details>/<img> deliberately.
    "MD033": false,

    // MD028 blank line inside blockquote: the README stacks several distinct
    // `>` callouts separated by blank lines. GitHub renders those as separate
    // blockquotes, so the rule's concern (accidental merging) does not apply —
    // and the usual workaround is littering the docs with `<!-- -->` spacers.
    "MD028": false,

    // MD024 duplicate headings: changelog-shaped docs legitimately repeat
    // headings under different parents. Only flag siblings.
    "MD024": { "siblings_only": true },

    // MD029 ordered-list prefix: allow both `1.`-repeated and incrementing
    // styles — Prettier normalizes these already.
    "MD029": { "style": "one_or_ordered" },

    // MD041 first-line-heading: templates and partials (issue/PR templates)
    // legitimately start with front matter or prose.
    "MD041": false,
  },
  "globs": ["**/*.md"],
  "ignores": [
    "node_modules",
    "**/node_modules/**",
    ".next",
    ".turbo",
    "dist",
    "coverage",

    // Generated by the CodeGuard tool, which owns their formatting — same
    // reason .prettierignore skips them.
    ".github/instructions/**",

    // BMAD-generated agents/workflows and their output.
    "_bmad/**",
    "_bmad-output/**",
    "docs/bmad-output/**",

    // Vendored skill docs, not authored here.
    "docs/superpowers/**",

    // Untracked local agent scratch state.
    ".remember/**",
  ],
}
